
# Database Configuration
DATABASE_URL='postgresql://user:password@host:port/database?sslmode=require'

# JWT Configuration
JWT_SECRET=your-secret-key-here-min-32-characters
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# OpenAI Configuration
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
OPENAI_MODEL=gpt-4
AGENT_TIMEOUT=30
CONTEXT_WINDOW_SIZE=20

# Kafka Configuration (for event-driven architecture)
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC_EVENTS=task-events
KAFKA_CONSUMER_GROUP=task-service-group

# Dapr Configuration (for distributed runtime)
DAPR_HTTP_ENDPOINT=http://localhost:3500

# Feature Flags
ENABLE_REMINDERS=true
ENABLE_RECURRENCE=true
ENABLE_EVENT_SOURCING=true

# $ minikube service todo-chatbot-backend
# $ minikube service todo-chatbot-frontend